# Chuỗi kết nối MongoDB (giống backend)
MONGODB=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vanban-project

# Bí mật dùng chung với backend (backend gửi qua header x-tool-secret)
TOOL_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=doi-thanh-chuoi-ngau-nhien-khac

# (Tùy chọn) siêu tham số LDA
# LDA_NUM_TOPICS=0          # 0 = bằng số nhãn có dữ liệu
# Nhãn thứ 2 (tối đa 2 nhãn / bài)
# LDA_SECOND_LABEL_MIN_SHARE=0.2          # nhãn 2 phải chiếm >= 20% nội dung
# LDA_SECOND_LABEL_MAX_CENTROID_SIM=0.9   # bỏ qua nếu 2 centroid quá giống nhau
# Collapsed Gibbs Sampling
# LDA_GIBBS_ITER=500        # tổng số vòng lặp khi huấn luyện
# LDA_GIBBS_BURN_IN=200     # số vòng bỏ đi ban đầu
# LDA_GIBBS_THIN=10         # cứ bao nhiêu vòng lấy 1 mẫu
# LDA_INFER_ITER=100        # số vòng khi suy luận bài mới
# LDA_INFER_BURN_IN=50
# LDA_TRAIN_TIME_BUDGET=40  # giây, dừng sớm để không vượt 60s của Vercel
# LDA_ALPHA=0               # <=0 = 1/K
# LDA_ETA=0.01
# LDA_TITLE_WEIGHT=2
# LDA_MIN_DOCS_PER_LABEL=1
# LDA_USE_LABEL_TEXT=true
